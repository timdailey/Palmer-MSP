---
const specs = [
  { label: 'Length', value: '2.3', unit: 'mi' },
  { label: 'Width', value: '40', unit: 'ft' },
  { label: 'Corners', value: '14' },
  { label: 'Absolute elev.', value: '~190', unit: 'ft' },
  { label: 'Cumulative', value: '~509', unit: 'ft' },
  { label: 'Pit stalls', value: '40' },
];
---

<section class="wrap" aria-labelledby="specs-title">
  <h2 id="specs-title" class="visually-hidden">Track specifications</h2>
  <dl class="specs">
    {
      specs.map((s) => (
        <div class="spec">
          <dt>{s.label}</dt>
          <dd>
            {s.value}
            {s.unit && <span class="unit"> {s.unit}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    overflow: hidden;
  }
  .spec {
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    border-right: 1px solid var(--line);
  }
  .spec:last-child {
    border-right: 0;
  }
  dt {
    font-size: 13px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 600;
    line-height: 1.2;
  }
  .unit {
    font-size: 18px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .specs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .spec {
      border-bottom: 1px solid var(--line);
    }
    .spec:nth-child(3n) {
      border-right: 0;
    }
    .spec:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }
  @media (max-width: 640px) {
    .specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-radius: var(--r-card);
    }
    .spec {
      padding: var(--s-2);
      gap: 4px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .spec:nth-child(3n) {
      border-right: 1px solid var(--line);
    }
    .spec:nth-child(2n) {
      border-right: 0;
    }
    .spec:nth-last-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
    .spec:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
    dt {
      font-size: 12px;
    }
    dd {
      font-size: 26px;
    }
  }
</style>
