---
// Illustrative track map. TODO: replace the path and corner positions with the official track map SVG.
interface Props {
  headingLevel?: 'h2' | 'h3';
  height?: number;
}
const { headingLevel: H = 'h2', height = 420 } = Astro.props;

const corners: [number, number][] = [
  [72, 262], [150, 200], [218, 160], [246, 98], [330, 92], [408, 72], [482, 108],
  [468, 170], [418, 218], [452, 290], [392, 336], [300, 320], [214, 356], [132, 346],
];
const path =
  'M90 320 C 60 250, 110 190, 180 200 S 230 90, 310 100 S 450 50, 480 130 S 410 220, 440 280 S 350 360, 280 330 S 150 380, 90 320 Z';
const label = (dir: 'clockwise' | 'counter-clockwise') =>
  `Illustrative track map with 14 corners numbered for ${dir} running. Placeholder until the official map is added.`;
---

<div class="panel track-map" data-track-map>
  <div class="head">
    <H class="title">Track map</H>
    <div class="toggle" role="group" aria-label="Direction" hidden>
      <button type="button" aria-pressed="true" data-dir="cw">Clockwise</button>
      <button type="button" aria-pressed="false" data-dir="ccw">Counter-clockwise</button>
    </div>
  </div>
  <svg
    width="100%"
    height={height}
    viewBox="0 0 560 420"
    fill="none"
    role="img"
    aria-label={label('clockwise')}
    data-label-cw={label('clockwise')}
    data-label-ccw={label('counter-clockwise')}
  >
    <path d={path} stroke="#2A3035" stroke-width="22" stroke-linejoin="round" />
    <path d={path} stroke="#F2F4F5" stroke-width="4" stroke-linejoin="round" />
    <rect x="84" y="312" width="16" height="6" fill="#D9A441" />
    <g class="arrow" data-arrow>
      <path d="M40 318 l8 -14 l8 14 z" fill="#D9A441" />
    </g>
    <g font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#0E1113">
      {
        corners.map(([x, y], i) => (
          <>
            <circle cx={x} cy={y} r="13" fill="#D9A441" />
            <text x={x} y={y + 5} text-anchor="middle" data-cw={i + 1} data-ccw={14 - i}>
              {i + 1}
            </text>
          </>
        ))
      }
    </g>
  </svg>
  <p class="caption">Illustrative layout — swap in the official track map.</p>
</div>

<style>
  .track-map {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .title {
    font-size: 20px;
  }
  .toggle {
    display: flex;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-btn);
    padding: 4px;
  }
  .toggle[hidden] {
    display: none;
  }
  .toggle button {
    border: 0;
    background: transparent;
    color: var(--text);
    font: 500 14px var(--font-body);
    padding: 10px 14px;
    border-radius: 4px;
    min-height: 44px;
    cursor: pointer;
  }
  .toggle button[aria-pressed='true'] {
    background: var(--gold);
    color: var(--on-gold);
    font-weight: 600;
  }
  svg {
    display: block;
    height: auto;
  }
  .arrow {
    transform-origin: 48px 311px;
    transition: transform 0.2s ease;
  }
  .ccw .arrow {
    transform: rotate(180deg);
  }
  .caption {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .track-map {
      padding: 18px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-track-map]').forEach((root) => {
    const group = root.querySelector<HTMLElement>('[role="group"]');
    const svg = root.querySelector('svg');
    if (!group || !svg) return;
    group.hidden = false;
    const buttons = group.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const dir = btn.dataset.dir as 'cw' | 'ccw';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        svg.classList.toggle('ccw', dir === 'ccw');
        svg.setAttribute('aria-label', svg.dataset[dir === 'cw' ? 'labelCw' : 'labelCcw'] ?? '');
        svg.querySelectorAll<SVGTextElement>('text[data-cw]').forEach((t) => {
          t.textContent = t.dataset[dir] ?? '';
        });
      }),
    );
  });
</script>
