---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, url, absUrl } from '../lib/site';
import { locationSchema, breadcrumbSchema, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path of the OG image under /public (1200×630). */
  ogImage?: string;
  /** Breadcrumb trail, excluding Home. Omit on the homepage. */
  crumbs?: Crumb[];
  jsonLd?: unknown[];
  noindex?: boolean;
}

const { title, description, ogImage = '/og/default.png', crumbs, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.trackName}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = absUrl(ogImage, Astro.site);
const trail = crumbs ? [{ name: 'Home', href: '/' }, ...crumbs] : undefined;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0E1113" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Palmer Motorsports Park: 2.3 miles, 14 corners, 509 feet of climb." />
    <meta name="twitter:card" content="summary_large_image" />

    <JsonLd data={locationSchema(Astro.site)} />
    {trail && <JsonLd data={breadcrumbSchema(trail, Astro.site)} />}
    {jsonLd.map((d) => <JsonLd data={d} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot name="before-main" />
    <main id="main">
      {trail && <Breadcrumbs crumbs={trail} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
